modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 25115
externalPort = 3000

[[ports]]
localPort = 25116
externalPort = 3002

[nix]
packages = ["nano"]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_TOKEN = "1v8k6n8PCDjJxs5rXmbGLUAmXEFNUum2zZ0gselS"
